# =============================================================================
# Ghostty — Override macOS
# Cargado vía symlink ~/.config/ghostty/config.local creado por ghostty.sh
# =============================================================================

# -- macOS-specific options ---------------------------------------------------
# Tratar la tecla Option como Alt (necesario para keybinds Alt+C de fzf, etc.)
macos-option-as-alt = true
macos-titlebar-style = tabs

# -- Keybindings (cmd-based) --------------------------------------------------
# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+enter=toggle_split_zoom

# Navegar entre splits
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:down

# Navegar splits secuencialmente (rápido con una mano)
keybind = cmd+[=goto_split:previous
keybind = cmd+]=goto_split:next

# Redimensionar splits
keybind = cmd+ctrl+left=resize_split:left,20
keybind = cmd+ctrl+right=resize_split:right,20
keybind = cmd+ctrl+up=resize_split:up,20
keybind = cmd+ctrl+down=resize_split:down,20

# Igualar tamaño de todos los splits
keybind = cmd+ctrl+=equalize_splits

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface

# Quick terminal (overlay global — invoca Ghostty desde cualquier app)
keybind = global:cmd+grave_accent=toggle_quick_terminal

# -- Quick terminal config ----------------------------------------------------
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0.15
