# =============================================================================
# Ghostty — Configuración base (compartida macOS + Linux)
# Docs: https://ghostty.org/docs/config/reference
#
# Los keybinds y opciones específicas de cada OS viven en:
#   - config-macos : cmd-based keybinds, opciones macos-*, quick terminal
#   - config-linux : alt/super-based keybinds (mapeo equivalente)
#
# El módulo ghostty.sh crea un symlink ~/.config/ghostty/config.local apuntando
# al archivo correcto según el OS. Así solo se carga el set válido y no hay
# warnings por modificadores desconocidos en cada arranque.
# =============================================================================

# -- Fuente -------------------------------------------------------------------
font-family = JetBrainsMono Nerd Font
font-size = 14
# Ligaduras tipográficas (ej: != -> ≠, => -> ⇒)
font-feature = calt
font-feature = liga

# -- Tema ---------------------------------------------------------------------
# Temas disponibles: ghostty +list-themes
# Populares: catppuccin-mocha, dracula, tokyonight, gruvbox-dark
theme = Catppuccin Mocha

# -- Ventana ------------------------------------------------------------------
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
background-opacity = 0.95

# -- Cursor -------------------------------------------------------------------
cursor-style = block
cursor-style-blink = false

# -- Shell --------------------------------------------------------------------
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# -- Clipboard ----------------------------------------------------------------
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

# -- Mouse --------------------------------------------------------------------
mouse-hide-while-typing = true

# -- Scrollback ---------------------------------------------------------------
scrollback-limit = 50000

# -- Splits — indicador visual de sección activa -----------------------------
# Los splits inactivos se atenúan para que sea obvio cuál es el activo
unfocused-split-opacity = 0.55

# -- Override OS-específico (keybinds + opciones de plataforma) --------------
# config.local es un symlink creado por ghostty.sh apuntando a:
#   - config-macos en macOS
#   - config-linux en Linux
# El prefijo `?` indica "incluir si existe" (no error si falta).
config-file = ?config.local
