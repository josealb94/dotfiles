# =============================================================================
# Ghostty — Configuración base (macOS)
# Docs: https://ghostty.org/docs/config/reference
#
# Los keybinds y opciones específicas de macOS viven en config-macos.
# El módulo ghostty.sh crea un symlink ~/.config/ghostty/config.local → config-macos.
# =============================================================================

# -- Fuente -------------------------------------------------------------------
font-family = JetBrainsMono Nerd Font
font-size = 14
# Ligaduras tipográficas (ej: != -> ≠, => -> ⇒)
font-feature = calt
font-feature = liga

# -- Tema ---------------------------------------------------------------------
# Temas disponibles: ghostty +list-themes
# Populares: catppuccin-mocha, dracula, tokyonight, gruvbox-dark
theme = Catppuccin Mocha

# -- Ventana ------------------------------------------------------------------
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
background-opacity = 0.95

# -- Cursor -------------------------------------------------------------------
cursor-style = block
cursor-style-blink = false

# -- Shell --------------------------------------------------------------------
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# -- Clipboard ----------------------------------------------------------------
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

# -- Mouse --------------------------------------------------------------------
mouse-hide-while-typing = true

# -- Scrollback ---------------------------------------------------------------
scrollback-limit = 50000

# -- Splits — indicador visual de sección activa -----------------------------
# Los splits inactivos se atenúan para que sea obvio cuál es el activo
unfocused-split-opacity = 0.55

# -- Override macOS (keybinds + opciones macos-*) ----------------------------
# config.local es un symlink → config-macos creado por ghostty.sh.
# El prefijo `?` indica "incluir si existe" (no error si falta).
config-file = ?config.local
