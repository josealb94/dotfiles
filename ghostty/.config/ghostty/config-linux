# =============================================================================
# Ghostty — Override Linux
# Cargado vía symlink ~/.config/ghostty/config.local creado por ghostty.sh
#
# Mapeo de modificadores (teclado HyperX con swap Option↔Command en macOS):
#   macOS cmd  ↔  Linux alt    (tecla física Alt junto al espacio)
#   macOS opt  ↔  Linux super  (tecla física Win)
#   macOS ctrl ↔  Linux ctrl   (tecla física Ctrl)
#
# CONFLICTO conocido con xfwm4 (Xfce default):
#   Ctrl+Alt+Left/Right está bindeado a "switch workspace" → intercepta
#   antes de Ghostty. Para que `alt+ctrl+arrows` (resize splits) funcione:
#     Settings → Window Manager → Keyboard
#     → eliminar bindings de "Move window to workspace left/right"
# =============================================================================

# -- Keybindings (alt como modificador primario, mismo gesto físico) ---------
# Splits
keybind = alt+d=new_split:right
keybind = alt+shift+d=new_split:down
keybind = alt+shift+enter=toggle_split_zoom

# Navegar entre splits (alt + super = mismo gesto que cmd+alt en macOS)
keybind = alt+super+left=goto_split:left
keybind = alt+super+right=goto_split:right
keybind = alt+super+up=goto_split:top
keybind = alt+super+down=goto_split:down

# Navegar splits secuencialmente
keybind = alt+[=goto_split:previous
keybind = alt+]=goto_split:next

# Redimensionar splits (requiere desbindear Ctrl+Alt+arrow en xfwm4)
keybind = alt+ctrl+left=resize_split:left,20
keybind = alt+ctrl+right=resize_split:right,20
keybind = alt+ctrl+up=resize_split:up,20
keybind = alt+ctrl+down=resize_split:down,20

# Igualar tamaño de todos los splits
keybind = alt+ctrl+=equalize_splits

# Tabs
keybind = alt+t=new_tab
keybind = alt+w=close_surface

# NOTA: No incluimos quick terminal global aquí. En Linux requiere cooperación
# del WM y el plan es delegarlo al tiling WM cuando se configure.
