# =============================================================================
# Ghostty — Configuración
# Docs: https://ghostty.org/docs/config/reference
# =============================================================================

# -- Fuente -------------------------------------------------------------------
font-family = JetBrainsMono Nerd Font
font-size = 14
# Ligaduras tipográficas (ej: != -> ≠, => -> ⇒)
font-feature = calt
font-feature = liga

# -- Tema ---------------------------------------------------------------------
# Temas disponibles: ghostty +list-themes
# Populares: catppuccin-mocha, dracula, tokyonight, gruvbox-dark
theme = Catppuccin Mocha

# -- Ventana ------------------------------------------------------------------
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
background-opacity = 0.95

# -- Cursor -------------------------------------------------------------------
cursor-style = block
cursor-style-blink = false

# -- Shell --------------------------------------------------------------------
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# -- Clipboard ----------------------------------------------------------------
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

# -- Mouse --------------------------------------------------------------------
mouse-hide-while-typing = true

# -- Scrollback ---------------------------------------------------------------
scrollback-limit = 10000

# -- Keybindings --------------------------------------------------------------
# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+enter=toggle_split_zoom

# Navegar entre splits
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:down

# Redimensionar splits
keybind = cmd+ctrl+left=resize_split:left,20
keybind = cmd+ctrl+right=resize_split:right,20
keybind = cmd+ctrl+up=resize_split:up,20
keybind = cmd+ctrl+down=resize_split:down,20

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface

# -- macOS --------------------------------------------------------------------
macos-option-as-alt = true
macos-titlebar-style = tabs
